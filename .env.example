# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MOSTRA

# Email (optionnel MVP)
RESEND_API_KEY=

# Web Push (notifications natives) — générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@mostra.app

# ── Stripe (paiements Checkout) ─────────────────────────────
# Clé secrète : serveur uniquement. Ne jamais la préfixer NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret de signature du webhook (dashboard Stripe > Développeurs > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxx
